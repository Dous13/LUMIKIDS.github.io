rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function ownsClass(code) {
      return isTeacher() &&
        get(/databases/$(database)/documents/classes/$(code)).data.teacherId == request.auth.uid;
    }

    function assignedTeacher(student) {
      return isTeacher() && student.teacherId == request.auth.uid && ownsClass(student.classCode);
    }

    function canReadStudent(studentId, student) {
      return student.id == studentId && assignedTeacher(student);
    }

    function progressFields() {
      return ['xp', 'coins', 'level', 'streak', 'readingXP', 'writingXP', 'mathXP',
        'avatar', 'ownedMascots', 'mistakes', 'readingProgress', 'writingProgress',
        'mathProgress', 'updatedAt'];
    }

    function validStudentUpdate(studentId, fields) {
      return canReadStudent(studentId, resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function sameRosterIdentity(student, other) {
      return student.id == other.id && student.teacherId == other.teacherId &&
        student.classCode == other.classCode;
    }

    function sameProgress(student, roster) {
      return !student.diff(roster).affectedKeys().hasAny(progressFields());
    }

    match /teachers/{teacherId} {
      allow get: if request.auth != null && teacherId == request.auth.uid;
      allow create: if request.auth != null && teacherId == request.auth.uid &&
        request.resource.data.id == teacherId &&
        request.resource.data.keys().hasOnly(['id', 'name', 'email', 'createdAt']);
    }

    match /classes/{code} {
      allow get, list: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.code == code &&
        request.resource.data.keys().hasOnly(['code', 'teacherId', 'teacherName', 'name', 'createdAt']);

      match /students/{studentId} {
        function rosterStudent() {
          return getAfter(/databases/$(database)/documents/students/$(studentId)).data;
        }

        allow get: if resource.data.classCode == code && resource.data.id == studentId &&
          ownsClass(code) && resource.data.teacherId == request.auth.uid;
        allow list: if ownsClass(code) && resource.data.teacherId == request.auth.uid;
        allow create: if ownsClass(code) && request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.id == studentId && request.resource.data.classCode == code &&
          request.resource.data == rosterStudent();
        allow update: if resource.data.classCode == code &&
          validStudentUpdate(studentId, progressFields()) &&
          sameRosterIdentity(request.resource.data, rosterStudent()) &&
          sameProgress(request.resource.data, rosterStudent());
      }
    }

    match /students/{studentId} {
      function matchingRoster(student) {
        return getAfter(/databases/$(database)/documents/classes/$(student.classCode)/students/$(studentId)).data;
      }

      allow get: if canReadStudent(studentId, resource.data);
      allow create: if request.resource.data.id == studentId && assignedTeacher(request.resource.data) &&
        request.resource.data == matchingRoster(request.resource.data);
      allow update: if validStudentUpdate(studentId, progressFields().concat(['profileReceipts', 'profileRevision'])) &&
        request.resource.data.profileRevision is int &&
        request.resource.data.profileRevision > resource.data.get('profileRevision', 0) &&
        sameRosterIdentity(request.resource.data, matchingRoster(resource.data)) &&
        sameProgress(request.resource.data, matchingRoster(resource.data));

      match /worksheetResults/{instanceId} {
        function student() {
          return get(/databases/$(database)/documents/students/$(studentId)).data;
        }

        function validCapture() {
          let capture = request.resource.data.get('capture', null);
          return capture == null || (capture is map && capture.validated == true &&
            capture.worksheetInstanceId == instanceId && capture.answers is list && capture.answers.size() == 5);
        }

        function validFinalization() {
          let data = request.resource.data;
          let result = data.get('finalized', null);
          return !data.keys().hasAny(['finalized']) || (result is map && assignedTeacher(student()) &&
            data.get('capture', null) is map && result.teacherId == request.auth.uid &&
            result.studentId == studentId && result.instanceId == instanceId &&
            result.subject == data.worksheet.subject && result.lessonId == data.worksheet.lessonId &&
            result.total == 5 && result.score is int && result.score >= 0 && result.score <= 5 &&
            result.passed is bool && result.finalizedAt is string &&
            (result.subject == 'writing' ? result.writing.size() == 5 : result.answers.size() == 5));
        }

        function validWorksheet() {
          let data = request.resource.data;
          return data.keys().hasOnly(['worksheet', 'capture', 'finalized']) &&
            data.worksheet.studentId == studentId && data.worksheet.instanceId == instanceId &&
            validCapture() && validFinalization();
        }

        allow get, list: if canReadStudent(studentId, student());
        allow create: if canReadStudent(studentId, student()) && validWorksheet();
        allow update: if canReadStudent(studentId, student()) &&
          resource.data.get('finalized', null) == null &&
          request.resource.data.worksheet == resource.data.worksheet && validWorksheet();
      }
    }
  }
}
