rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function teacherAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' &&
        request.auth.token.get('role', '') != 'student' && !request.auth.uid.matches('^student:.*');
    }

    function isTeacher() {
      return teacherAccount() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function ownsClass(code) {
      return isTeacher() &&
        get(/databases/$(database)/documents/classes/$(code)).data.teacherId == request.auth.uid;
    }

    function assignedTeacher(student) {
      return teacherAccount() && student.teacherId == request.auth.uid && ownsClass(student.classCode);
    }

    function verifiedEnrollment(student) {
      let classroom = get(/databases/$(database)/documents/classes/$(student.classCode)).data;
      let rosterPath = /databases/$(database)/documents/classes/$(student.classCode)/students/$(student.id);
      return classroom.code == student.classCode && classroom.teacherId == student.teacherId &&
        exists(/databases/$(database)/documents/teachers/$(student.teacherId)) &&
        (exists(rosterPath)
          ? get(rosterPath).data.id == student.id && get(rosterPath).data.classCode == student.classCode &&
            get(rosterPath).data.teacherId == student.teacherId
          : !student.keys().hasAny(['preferredNameLower']));
    }

    function currentStudentGrant(studentId) {
      let path = /databases/$(database)/documents/studentAccess/$(studentId);
      return exists(path)
        ? get(path).data.enabled == true && request.auth.token.sessionVersion == get(path).data.version
        : request.auth.token.sessionVersion == 0;
    }

    function ownsStudent(student) {
      return request.auth != null && request.auth.token.get('role', '') == 'student' &&
        request.auth.token.studentId == student.id && request.auth.uid == 'student:' + student.id &&
        request.auth.token.classCode == student.classCode &&
        currentStudentGrant(student.id) && verifiedEnrollment(student);
    }

    function canReadStudent(studentId, student) {
      return student.id == studentId && (assignedTeacher(student) || ownsStudent(student));
    }

    function nonempty(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function validInitialStudent(studentId, code, data) {
      let fields = ['id', 'fullName', 'name', 'preferredName', 'preferredNameLower', 'classCode',
        'teacherId', 'xp', 'coins', 'level', 'streak', 'readingXP', 'writingXP', 'mathXP', 'avatar', 'createdAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&
        data.id == studentId && studentId.matches('^[A-Za-z0-9_-]{1,96}$') &&
        data.classCode == code && data.teacherId == request.auth.uid &&
        nonempty(data.fullName, 120) && nonempty(data.name, 100) &&
        data.name == data.preferredName && data.preferredNameLower == data.name.lower() &&
        data.xp is int && data.xp == 0 && data.coins is int && data.coins == 0 &&
        data.level is int && data.level == 1 && data.streak is int && data.streak == 0 &&
        data.readingXP is int && data.readingXP == 0 && data.writingXP is int && data.writingXP == 0 &&
        data.mathXP is int && data.mathXP == 0 && data.avatar == 'default' && data.createdAt == request.time;
    }

    match /teachers/{teacherId} {
      allow get: if teacherAccount() && teacherId == request.auth.uid;
      allow create: if teacherAccount() && teacherId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['id', 'name', 'email', 'createdAt']) &&
        request.resource.data.id == teacherId &&
        nonempty(request.resource.data.name, 100) &&
        request.resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.createdAt == request.time;
    }

    match /classes/{code} {
      allow get, list: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && code.matches('^[A-Z2-9]{6}$') &&
        request.resource.data.keys().hasOnly(['code', 'teacherId', 'teacherName', 'name', 'createdAt']) &&
        request.resource.data.teacherId == request.auth.uid && request.resource.data.code == code &&
        nonempty(request.resource.data.teacherName, 100) && nonempty(request.resource.data.name, 120) &&
        request.resource.data.createdAt == request.time;

      match /students/{studentId} {
        allow get: if ownsClass(code) && resource.data.classCode == code &&
          resource.data.id == studentId && resource.data.teacherId == request.auth.uid;
        allow list: if ownsClass(code) && resource.data.teacherId == request.auth.uid;
        allow create: if ownsClass(code) && validInitialStudent(studentId, code, request.resource.data) &&
          request.resource.data == getAfter(/databases/$(database)/documents/students/$(studentId)).data;
      }
    }

    match /students/{studentId} {
      allow get: if canReadStudent(studentId, resource.data);
      allow create: if assignedTeacher(request.resource.data) &&
        validInitialStudent(studentId, request.resource.data.classCode, request.resource.data) &&
        request.resource.data == getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classCode)/students/$(studentId)).data;

      match /worksheetResults/{instanceId} {
        allow get, list: if canReadStudent(studentId, get(/databases/$(database)/documents/students/$(studentId)).data);
      }

      match /syncReceipts/{receiptId} {
        allow read, write: if false;
      }
    }

    match /loginLimits/{bucketId} {
      allow read, write: if false;
    }

    match /studentAccess/{studentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
